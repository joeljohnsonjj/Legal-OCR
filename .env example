# Google Cloud AI Configuration
# Set to false to use direct Gemini API (recommended for local development)
# Set to true to use Vertex AI (requires GCP project and credentials)
GOOGLE_GENAI_USE_VERTEXAI=True

# Gemini API Key (required for direct API mode)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY= 

# GCP Project Configuration (optional, only needed if GOOGLE_GENAI_USE_VERTEXAI=true)
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=

# Gemini Model Configuration
GEMINI_MODEL=gemini-2.5-flash

# Google Cloud Storage Configuration (for future GCS integration)
GCS_BUCKET=heb-legal
GCS_DOCS_FOLDER=Documents
GCS_OUTPUT_FOLDER=Output

# Fake GCS Server Configuration (for local GCS emulation)
# For standalone mode (run_emulator.py): use http://localhost:4443
# For Docker mode: use http://fake-gcs-server:4443
STORAGE_EMULATOR_HOST=http://localhost:4443
FAKE_GCS_ENDPOINT=http://localhost:4443

# GCS Emulator Configuration (for run_emulator.py)
GCS_EMULATOR_HOST=localhost
GCS_EMULATOR_PORT=4443
GCS_EMULATOR_DATA_DIR=./fake-gcs-data
GCS_EMULATOR_IN_MEMORY=false

# Processing Configuration
PROMPT_FILE=prompt.txt
DOCS_FOLDER=docs
OUTPUT_FOLDER=output
LOGS_FOLDER=logs
CACHE_FOLDER=ocr_cache

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false