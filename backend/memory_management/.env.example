# memory_management — example environment variables
# Copy to your application .env and load with python-dotenv before starting the API.
# Session/compaction/cleanup keys are read via os.environ when using session_config_from_env()
# and get_cleanup_config_from_env() (no host Settings class required).

# --- PostgreSQL (host app provides connection; typical names used with SQLAlchemy/psycopg2) ---
# DB_NAME=yourdb
# DB_USER=youruser
# DB_PASSWORD=secret
# DB_HOST=localhost
# DB_PORT=5432
# DB_SSLMODE=disable
# Or a single URL:
# DATABASE_URL=postgresql://user:pass@localhost:5432/yourdb

# --- Session ---
SESSION_ENABLED=true
SESSION_PROVIDER=postgres
# When SESSION_PROVIDER=sqlite, set SESSION_DB_PATH to a local file path
# SESSION_DB_PATH=output/session_store.sqlite
SESSION_TTL_SECONDS=1800
SESSION_CLEANUP_INTERVAL_SECONDS=300

# --- Compaction (in-session summarization) ---
# The library calls llm_summarize(prompt) YOU pass to initialize/process_turn — not this file alone.
# COMPACTION_LLM_MODEL is used by YOUR app to build that callable (e.g. second Bedrock client). See docs/GETTING_STARTED.md §7.
COMPACTION_ENABLED=true
COMPACTION_TURNS_THRESHOLD=10
COMPACTION_KEEP_LAST_N=20
COMPACTION_MAX_TURNS=10
# Optional: trigger when estimated tokens exceed (omit or empty to disable)
# COMPACTION_TOKEN_BUDGET=
COMPACTION_USE_LLM=true
# Optional: only if your host code reads this and wires Bedrock for compaction summarization
# COMPACTION_LLM_MODEL=us.amazon.nova-lite-v1:0

# --- Archive & cleanup job ---
ARCHIVE_ON_EXPIRY=true
CLEANUP_ARCHIVE_LIMIT=100
# Host may set ENABLE_BACKGROUND_SESSION_CLEANUP=true to let initialize() start a thread (host-specific).

# --- Working state debug trace (JSONL). Set to 0 / false / off to disable. ---
WORKING_STATE_TRACE_FILE=working_state_trace.jsonl

# --- Memory (Mem0) — pass the same keys into set_memory_config(dict) or host Settings ---
MEMORY_ENABLED=true
MEMORY_PROVIDER=mem0
# Vector store: qdrant (default) or faiss
MEMORY_VECTOR_STORE=qdrant
# Local Qdrant path mode (optional). If set, Mem0 uses QdrantClient(path=...).
# MEMORY_QDRANT_PATH=output/qdrant_mem0
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Optional Qdrant Cloud: set both URL and API key (Mem0 validates url+api_key together)
# QDRANT_URL=
# QDRANT_API_KEY=
# Collection name in Qdrant (empty → use MEM0_DEFAULT_COLLECTION)
MEM0_QDRANT_COLLECTION=
# Fallback collection when MEM0_QDRANT_COLLECTION is empty
MEM0_DEFAULT_COLLECTION=mem0_memories
# Fallback rerank model id when MEM0_RERANK_MODEL is empty
MEM0_DEFAULT_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Patch Mem0 to load cross-encoder/* models with CrossEncoder (recommended true)
MEM0_PATCH_CROSS_ENCODER_RERANKER=true
# Persist vectors on disk inside Qdrant (optional)
# QDRANT_ON_DISK=false
MEMORY_FAISS_PATH=faiss_index/memories
MEMORY_INFER=false
# Sentence-transformers cross-encoder reranking (Mem0 search)
MEM0_RERANK_ENABLED=true
MEM0_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# MEM0_RERANK_DEVICE=cuda
# MEM0_RERANK_BATCH_SIZE=32
# MEMORY_LLM_PROVIDER=langchain
# MEMORY_LLM_PROVIDER=litellm
# (When using dict for set_memory_config, use lowercase keys: memory_llm_provider, memory_enabled, …)
# MEMORY_LITELLM_MODEL=bedrock/us.amazon.nova-pro-v1:0

# --- AWS (Bedrock: chat, embeddings, Mem0 LangChain path) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BEDROCK_MODEL=us.amazon.nova-pro-v1:0
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# --- Azure OpenAI (optional; if set, Mem0 uses Azure for fact extraction LLM) ---
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_KEY=
# AZURE_OPENAI_API_VERSION=2024-02-15-preview
# AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment

# --- Opik (optional tracing). Disable with OPIK_TRACK_DISABLE=true — there is no TRACING_ENABLED in this library. Docs: https://www.comet.com/docs/opik/tracing/sdk_configuration ---
# OPIK_API_KEY=
# OPIK_WORKSPACE=
# OPIK_PROJECT_NAME=memory-management
# OPIK_URL_OVERRIDE=
# OPIK_CONFIG_PATH=
# OPIK_TRACK_DISABLE=
# OPIK_DEFAULT_FLUSH_TIMEOUT=
# OPIK_CHECK_TLS_CERTIFICATE=
# OPIK_CONSOLE_LOGGING_LEVEL=
# OPIK_FILE_LOGGING_LEVEL=
# OPIK_DEFAULT_LLM=
