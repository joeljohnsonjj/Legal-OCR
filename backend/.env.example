# ========== Use Azure OpenAI ==========
USE_AZURE_OPENAI=True
 
# Azure OpenAI (required when USE_AZURE_OPENAI=True)
# Endpoint from Azure Portal: your resource -> Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_TIMEOUT_SECONDS=300
 
# Use local sentence-transformers for embeddings (no Azure embedding call; faster queries)
USE_LOCAL_EMBEDDING=True
# Or use Azure embeddings: create a deployment in Azure Portal and set e.g.:
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
 
# GCS simulator (fake GCS) - required when using run_emulator.py
STORAGE_EMULATOR_HOST=http://localhost:4443
GCS_BUCKET=legal-ocr-documents
 
# Vector search: max distance for similarity (default 1.4; higher = more results)
VECTOR_MAX_DISTANCE=2.0
 
# -----------------------------------------------------------------------------
# Optional: document folders, OCR, API (defaults used if unset)
# -----------------------------------------------------------------------------
# DOCS_FOLDER=docs
# OUTPUT_FOLDER=output
# LOGS_FOLDER=logs
# CACHE_FOLDER=ocr_cache
# PROMPT_FILE=prompt.txt
# POPPLER_PATH=
# API Configuration
# API_HOST=0.0.0.0
# API_PORT=8000
# API_RELOAD=false
#
# Chatbot / RAG (Qdrant) — set true so /process indexes data for POST /chat
# RAG_INDEX_QDRANT=true
# QDRANT_PATH=output/qdrant_rag
# RAG_QDRANT_COLLECTION=legal_rag
#
# Session + Mem0 memory (chat). For simple server setup without Postgres:
# SESSION_ENABLED=true
# SESSION_PROVIDER=sqlite
# SESSION_DB_PATH=output/session_store.sqlite
# MEMORY_ENABLED=true
# MEMORY_VECTOR_STORE=qdrant
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# Or local file mode for Mem0: MEMORY_QDRANT_PATH=output/qdrant_mem0
# Long page extraction: raise output token cap if JSON is truncated or parse fails
# LEGAL_OCR_ANALYZE_PAGE_MAX_OUTPUT_TOKENS=16384
# (optional) LEGAL_OCR_ANALYZE_SECTION_MAX_OUTPUT_TOKENS=16384
# Provider-wide defaults still apply when unset: GEMINI_MAX_OUTPUT_TOKENS, BEDROCK_MAX_TOKENS,
# AZURE_OPENAI_MAX_TOKENS / OPENAI_MAX_OUTPUT_TOKENS
