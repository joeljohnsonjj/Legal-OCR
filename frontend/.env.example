# Optional: Gemini citation extraction for chat Sources (server reads these; never expose GEMINI_API_KEY to the client)
# citation-normalize-server loads this file from the project root via dotenv.
# Run: npm run citation-normalize-server (default port 8001)
# Optional: CITATION_NORMALIZE_PORT=8001
GEMINI_API_KEY=
# Model id from Google AI Studio (e.g. gemini-2.0-flash-lite, gemini-2.5-flash-preview-05-20, or your preview id)
GEMINI_CITATION_MODEL=gemini-2.0-flash-lite

# Vite: disable client calls to /api/normalize-citations (default is enabled in dev when proxy is used)
# VITE_AI_CITATIONS=false

# Local dev (see .env.development). Production Docker build uses:
# VITE_API_BASE_URL=/legal-ocr/backend
# VITE_BASE_PATH=/legal-ocr/

# Real lease/query API (Python backend). NOT the stub — stub is optional for local demos only.
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Production or custom URL for POST /normalize-citations body: { "citations": string[] }
# VITE_CITATION_NORMALIZER_URL=https://your-api.example.com/normalize-citations
